# Digital Human Job Runner configuration

DHJR_WORKSPACE=/home/YOUR_USER/AI-Workspace

DHJR_APP_NAME=Digital Human Job Runner
DHJR_APP_VERSION=0.2.0
DHJR_BACKEND_HOST=127.0.0.1
DHJR_BACKEND_PORT=8018
DHJR_FRONTEND_ORIGIN=http://127.0.0.1:5173
DHJR_EXTRA_CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://127.0.0.1:8018

DHJR_INPUT_DIR=/home/YOUR_USER/AI-Workspace/DigitalHumanInput
DHJR_OUTPUT_DIR=/home/YOUR_USER/AI-Workspace/DigitalHumanOutput
DHJR_JOBS_DIR=/home/YOUR_USER/AI-Workspace/jobs
DHJR_LOGS_DIR=/home/YOUR_USER/AI-Workspace/logs
DHJR_WINDOWS_OUTPUT_DIR=/mnt/c/Users/YOUR_WINDOWS_USER/Desktop/DigitalHumanOutput

DHJR_BACKGROUNDS_JSON=/home/YOUR_USER/AI-Workspace/app/config/backgrounds.json
DHJR_BACKGROUND_ASSETS_DIR=/home/YOUR_USER/AI-Workspace/assets/backgrounds
DHJR_DEFAULT_AVATAR_VIDEO=/home/YOUR_USER/AI-Workspace/VideoRefs/boss/default/boss_default.mp4

DHJR_DEFAULT_VOICE_ID=default_voice
DHJR_SUPPORTED_VOICE_IDS=default_voice
DHJR_LEGACY_VOICE_IDS=boss_voxcpm2_lora

DHJR_RUN_SCRIPT=/home/YOUR_USER/AI-Workspace/scripts/run_cleanvideo_job.sh
DHJR_RUN_VOICE_SCRIPT=/home/YOUR_USER/AI-Workspace/scripts/run_voice_only_job.sh
DHJR_LATENTSYNC_WORK_DIR=/home/YOUR_USER/AI-Workspace/projects/LatentSync/data/overlap_full_work

DHJR_FFMPEG_CANDIDATES=ffmpeg,/home/YOUR_USER/miniconda3/envs/latentsync/bin/ffmpeg
DHJR_FFPROBE_CANDIDATES=ffprobe,/home/YOUR_USER/miniconda3/envs/latentsync/bin/ffprobe
DHJR_SHUTDOWN_EXE=/mnt/c/Windows/System32/shutdown.exe
DHJR_PYTHON_BIN=python3
